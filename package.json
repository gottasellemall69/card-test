{
  "name": "card-test",
  "version": "0.2.0",
  "private": true,
  "description": "Yu-Gi-Oh and sports card pricing, collections, and deck building",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:turbo": "next dev --turbopack",
    "dev:webpack": "next dev --webpack",
    "build": "next build --turbopack",
    "build:webpack": "next build --webpack",
    "start": "next start",
    "lint": "eslint pages components constants context hooks lib proxy scripts services types utils next.config.js proxy.ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test",
    "format": "prettier --write .",
    "db:setup": "node --import tsx scripts/setup-database.ts",
    "refresh:yugioh-cache": "node --import tsx scripts/refresh-yugioh-cache.ts",
    "refresh:sports-cache": "node scripts/refresh-sports-cache.js",
    "prices:track": "node --import tsx scripts/track-prices.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@headlessui/react": "2.2.10",
    "@heroicons/react": "2.2.0",
    "@next/env": "16.4.5",
    "@vercel/speed-insights": "2.0.0",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "jsonwebtoken": "9.0.3",
    "lucide-react": "1.67.0",
    "mongodb": "7.8.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "swr": "2.5.1",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0"
  },
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/postcss": "4.3.4",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "mongodb-memory-server": "11.3.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
