{
  "name": "card-test",
  "version": "0.2.0",
  "private": true,
  "description": "Yu-Gi-Oh and sports card pricing, collections, and deck building",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:turbo": "next dev --turbopack",
    "dev:webpack": "next dev --webpack",
    "build": "next build --turbopack",
    "build:webpack": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test",
    "format": "prettier --write .",
    "db:setup": "node --import tsx scripts/setup-database.ts",
    "refresh:yugioh-cache": "node --import tsx scripts/refresh-yugioh-cache.ts",
    "refresh:sports-cache": "node scripts/refresh-sports-cache.js",
    "prices:track": "node --import tsx scripts/track-prices.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@headlessui/react": "2.2.10",
    "@heroicons/react": "2.2.0",
    "@next/env": "16.4.0",
    "@vercel/speed-insights": "2.0.0",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "jsonwebtoken": "9.0.3",
    "lucide-react": "1.55.0",
    "mongodb": "7.7.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "swr": "2.5.1",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0"
  },
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/postcss": "4.3.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "mongodb-memory-server": "11.3.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
